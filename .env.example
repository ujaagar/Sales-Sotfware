# Ujaagar Sales: environment variables.
# Copy this file to .env.local and fill in the values. Never commit .env.local or paste these into chat.

# ---------- Supabase (supabase.com → your project) ----------
# Project Settings → Data API → Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → "anon public" key (or the "publishable" key, sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API Keys → "service_role" secret key (or the "secret" key, sb_secret_…). Server only.
SUPABASE_SERVICE_ROLE_KEY=
# The part before .supabase.co in the Project URL (also in Project Settings → General → Project ID)
SUPABASE_PROJECT_REF=
# The database password you chose when creating the project (Project Settings → Database → Reset if forgotten)
SUPABASE_DB_PASSWORD=
# supabase.com/dashboard/account/tokens → Generate new token (used to push migrations and generate types)
SUPABASE_ACCESS_TOKEN=

# ---------- The one CEO account (used once by `pnpm seed:ceo`) ----------
CEO_NAME=
CEO_EMAIL=
# At least 10 characters. You can remove it from this file after running seed:ceo.
CEO_PASSWORD=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Any long random string. Protects the daily 9 AM job (/api/cron/daily).
CRON_SECRET=
# Any long random string. Used to hash IP addresses for the application-form rate limit.
IP_HASH_SALT=

# ---------- Cloudflare Turnstile (captcha on /apply) ----------
# dash.cloudflare.com → Turnstile → Add site. For local testing, these always-pass test keys work:
#   site key 1x00000000000000000000AA   secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Email (optional; in-app notifications work without it) ----------
# resend.com → API Keys. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Ujaagar Sales <sales@example.com>

# ---------- Demo data (development project only, `pnpm seed:demo`) ----------
# Password given to the 3 demo agents so you can log in as them.
DEMO_AGENT_PASSWORD=
